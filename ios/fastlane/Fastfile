# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # The issuer id and key id must belong to the same team as the app
    # (App Store Connect > Users and Access > Integrations), otherwise the
    # upload fails with "Couldn't find app". The .p8 itself is gitignored.
    app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID", "7K28D29DU3"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID", "69a6de8b-24e1-47e3-e053-5b8c7c11a4d1"),
        key_filepath: ENV.fetch("ASC_KEY_FILEPATH", "AuthKey_7K28D29DU3.p8"),
        duration: 1200,
        in_house: false
    )
    increment_build_number(xcodeproj: "Runner.xcodeproj")
    # The /usr/local/bin/xcpretty stub on this machine cannot load its gem, and
    # gym pipes xcodebuild through it with `set -o pipefail`, which turns a
    # successful archive into "Error building the application".
    # Install xcbeautify (`brew install xcbeautify`) and use it here for
    # prettier logs.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      xcodebuild_formatter: "",
      export_xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(
        beta_app_review_info: {
            contact_email: "kangibnux@gmail.com",
            contact_first_name: "Ibnu",
            contact_last_name: "Maksum",
            contact_phone: ENV.fetch("BETA_CONTACT_PHONE", "+628111204268"),
            demo_account_name: "OC62NENG",
            demo_account_password: ENV["DEMO_ACCOUNT_PASSWORD"]

        },
        groups: "komunitas"
    )
  end
end
